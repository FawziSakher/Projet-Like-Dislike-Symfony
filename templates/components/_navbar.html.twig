
{# templates/components/_navbar.html.twig #}

<nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('app_home_page') }}"><span style="color: blue;font-weight: bold;">Acceuil</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
        
                {% if is_granted('ROLE_USER') %}
                   
                    <li class="nav-item">
                        <a class="navbar-brand" href="{{ path('app_post_index') }}"><span style="color: blue;font-weight: bold;">Details</span></a>
                     </li>
                {% endif %}
                 
                {% if is_granted('ROLE_ADMIN') %}
        
                    <li class="nav-item">
                        <a class="navbar-brand" href="{{ path('app_users_list') }}"><span style="color: blue;font-weight: bold;">Gestion Users</span></a>
                     </li>
                {% endif %}
            </ul>
            <ul class="navbar-nav ms-auto">
                {% if is_granted('ROLE_USER') %}
                 
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ app.user.email }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_post_new') }}"><span style="color: blue;">Créer Post</span></a></li>
                       
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}"><span style="color: red;">Déconnexion</span></a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="navbar-brand" href="{{ path('app_login') }}"><span style="color: red;">Connexion</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="navbar-brand" href="{{ path('app_register') }}"><span style="color: blue;">Inscription</span></a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>