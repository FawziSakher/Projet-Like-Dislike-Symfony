{% extends 'base.html.twig' %}

{% block title %}Post index{% endblock %}

{% block body %}
<div class="container">
        <h1 style="color: red; text-align: center;">Posts Details</h1>

    <table class="table">
        <thead align="center">
            <tr>
                <th>N°</th>
                <th>Titre</th>
                <th>Contenu</th>
                    {% if is_granted('ROLE_ADMIN') %}
                      <th>Propriétaire</th>
                    {% endif %}
                <th>  </th>
            </tr>
        </thead>
        <tbody>
        {% for post in posts %}
            <tr>
                <td>{{ post.id }}</td>
                <td>{{ post.title }}</td>
                <td>{{ post.content }}</td>
                    {% if is_granted('ROLE_ADMIN') %}
                       <td>{{ post.author.email }}</td>
                 {% endif %}
        
                <td>
                    <a href="{{ path('app_post_show', {'id': post.id}) }}">Voir</a>
                    <a href="{{ path('app_post_edit', {'id': post.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4"> pas de post publié </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_post_new') }}">Create new</a>
</div>
{% endblock %}
